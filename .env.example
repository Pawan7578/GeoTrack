# ─────────────────────────────────────────────────────────────────────────────
# GeoTrack — Environment Variables
# Copy this file to .env at the repo root.
# This single file is used by docker-compose, the backend, and the frontend.
#
# In production, set each variable in the platform dashboard:
#   Backend  → Render environment variables
#   Frontend → Vercel environment variables
#
# NOTE: VITE_* variables are baked into the frontend at BUILD TIME by Vite.
#       Changing them after a build requires redeploying the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (docker-compose builds DATABASE_URL from these) ─────────────────
DB_USER=geofence
DB_PASSWORD=geofence_pass
DB_NAME=geofence_db

# Full DSN — used directly by the backend (overrides the parts above in production)
# Local:      postgresql://geofence:geofence_pass@localhost:5432/geofence_db?sslmode=disable
# Production: Set this to your Render/Railway Internal Database URL
DATABASE_URL=postgresql://postgres.hbswbrgdrrztybhlxahh:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
# Optional — DB connection retry tuning (defaults shown)
# DB_CONNECT_RETRIES=12
# DB_CONNECT_RETRY_DELAY=3s
# DB_PING_TIMEOUT=5s

# ── Backend server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters

# ── CORS / WebSocket ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local:      http://localhost:3000,http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_WS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend (Vite build-time variables) ──────────────────────────────────────
# Local:      http://localhost:8080/api  |  ws://localhost:8080
# Production: https://your-backend.onrender.com/api  |  wss://your-backend.onrender.com
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080
